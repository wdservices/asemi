{
  "entities": {
    "Role": {
      "title": "Role",
      "description": "User role assignment",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "User role (admin or company)"
        }
      },
      "required": ["role"]
    },
    "Company": {
      "title": "Company",
      "description": "Registered company entity",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner"
        },
        "name": {
          "type": "string",
          "description": "Brand/company legal name"
        },
        "email": {
          "type": "string",
          "description": "Corporate contact email"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "address": {
          "type": "string",
          "description": "Physical headquarters address"
        },
        "category": {
          "type": "string",
          "description": "Industry category"
        },
        "registrationNumber": {
          "type": "string",
          "description": "Business tax or registration ID"
        },
        "countryCode": {
          "type": "string",
          "description": "ISO 2-letter country code"
        },
        "status": {
          "type": "string",
          "description": "Verification status (pending, approved, needs_info, rejected)"
        },
        "logoUrl": {
          "type": "string",
          "description": "Brand logo URL"
        },
        "documentUrl": {
          "type": "string",
          "description": "Proof of registration document URL"
        },
        "adminNote": {
          "type": "string",
          "description": "Admin review commentary"
        },
        "freeCodesUsed": {
          "type": "number",
          "description": "Number of free starter codes utilized"
        },
        "totalCodesGenerated": {
          "type": "number",
          "description": "Cumulative codes generated"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp last updated"
        }
      },
      "required": ["ownerId", "name", "email", "registrationNumber", "countryCode", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog item",
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "description": "Owning company UID"
        },
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "sku": {
          "type": "string",
          "description": "Stock keeping unit"
        },
        "skuLookup": {
          "type": "string",
          "description": "Normalized uppercase SKU for indexed search"
        },
        "category": {
          "type": "string",
          "description": "Product category"
        },
        "description": {
          "type": "string",
          "description": "Product summary"
        },
        "imageUrls": {
          "type": "array",
          "description": "Gallery image URLs"
        },
        "lotNumber": {
          "type": "string",
          "description": "Default lot number"
        },
        "mfgDate": {
          "type": "string",
          "description": "Default manufacturing date (YYYY-MM-DD)"
        },
        "expiryDate": {
          "type": "string",
          "description": "Default expiry date (YYYY-MM-DD)"
        },
        "regulatoryNumber": {
          "type": "string",
          "description": "Regulatory approval or compliance identifier"
        },
        "recalled": {
          "type": "boolean",
          "description": "Whether the product has an active recall alert"
        },
        "recallReason": {
          "type": "string",
          "description": "Consumer-facing recall advisory notice"
        },
        "recalledAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when product recall was activated"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp created"
        }
      },
      "required": ["companyId", "name", "category"]
    },
    "Batch": {
      "title": "Batch",
      "description": "Batch of authentication codes",
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "description": "Owning company UID"
        },
        "productId": {
          "type": "string",
          "description": "Associated product ID"
        },
        "productName": {
          "type": "string",
          "description": "Snapshot of product name"
        },
        "sku": {
          "type": "string",
          "description": "Batch or product SKU"
        },
        "skuLookup": {
          "type": "string",
          "description": "Normalized uppercase SKU for indexed search"
        },
        "batchNumber": {
          "type": "string",
          "description": "Human readable batch number"
        },
        "quantity": {
          "type": "number",
          "description": "Number of unit codes in batch"
        },
        "amountCharged": {
          "type": "number",
          "description": "Total payment amount"
        },
        "currency": {
          "type": "string",
          "description": "Currency code"
        },
        "status": {
          "type": "string",
          "description": "Batch generation status (awaiting_payment, generating, ready, exported, failed)"
        },
        "lotNumber": {
          "type": "string",
          "description": "Production lot identifier"
        },
        "mfgDate": {
          "type": "string",
          "description": "Batch manufacture date (YYYY-MM-DD)"
        },
        "expiryDate": {
          "type": "string",
          "description": "Batch expiry date (YYYY-MM-DD)"
        },
        "recalled": {
          "type": "boolean",
          "description": "Whether this batch is currently recalled"
        },
        "recallReason": {
          "type": "string",
          "description": "Consumer-facing recall advisory notice"
        },
        "recalledAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when batch recall was activated"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp created"
        }
      },
      "required": ["companyId", "productId", "quantity", "status"]
    },
    "PublicBatchStatus": {
      "title": "PublicBatchStatus",
      "description": "Publicly readable provenance and recall state for a batch (zero PII/financial fields)",
      "type": "object",
      "properties": {
        "batchId": {
          "type": "string",
          "description": "Associated batch ID"
        },
        "companyId": {
          "type": "string",
          "description": "Owning company UID"
        },
        "productId": {
          "type": "string",
          "description": "Associated product ID"
        },
        "sku": {
          "type": "string",
          "description": "Batch or product SKU"
        },
        "lotNumber": {
          "type": "string",
          "description": "Lot identifier"
        },
        "mfgDate": {
          "type": "string",
          "description": "Manufacture date"
        },
        "expiryDate": {
          "type": "string",
          "description": "Expiry date"
        },
        "recalled": {
          "type": "boolean",
          "description": "Active recall flag"
        },
        "recallReason": {
          "type": "string",
          "description": "Consumer-facing recall notice"
        },
        "recalledAt": {
          "type": "string",
          "description": "ISO timestamp of recall"
        }
      },
      "required": ["batchId", "companyId", "recalled"]
    },
    "PublicProductStatus": {
      "title": "PublicProductStatus",
      "description": "Publicly readable SKU, provenance, and recall state for a product (zero PII)",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Associated product ID"
        },
        "companyId": {
          "type": "string",
          "description": "Owning company UID"
        },
        "sku": {
          "type": "string",
          "description": "Product SKU"
        },
        "lotNumber": {
          "type": "string",
          "description": "Default lot identifier"
        },
        "mfgDate": {
          "type": "string",
          "description": "Default manufacture date"
        },
        "expiryDate": {
          "type": "string",
          "description": "Default expiry date"
        },
        "recalled": {
          "type": "boolean",
          "description": "Active product-wide recall flag"
        },
        "recallReason": {
          "type": "string",
          "description": "Consumer-facing recall notice"
        },
        "recalledAt": {
          "type": "string",
          "description": "ISO timestamp of recall"
        }
      },
      "required": ["productId", "companyId", "recalled"]
    },
    "Code": {
      "title": "Code",
      "description": "Unique anti-counterfeit product code",
      "type": "object",
      "properties": {
        "batchId": {
          "type": "string",
          "description": "Batch ID"
        },
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "companyId": {
          "type": "string",
          "description": "Company UID"
        },
        "codeString": {
          "type": "string",
          "description": "Formatted anti-counterfeit code"
        },
        "sku": {
          "type": "string",
          "description": "Associated unit SKU"
        },
        "skuLookup": {
          "type": "string",
          "description": "Normalized uppercase SKU for indexed unit lookup"
        },
        "scanCount": {
          "type": "number",
          "description": "Verification scan count"
        },
        "flagged": {
          "type": "boolean",
          "description": "Fraud flag status"
        },
        "reviewStatus": {
          "type": "string",
          "description": "Moderation status (none, open, reviewed, escalated)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp created"
        }
      },
      "required": ["batchId", "productId", "companyId", "codeString"]
    },
    "Scan": {
      "title": "Scan",
      "description": "Consumer verification scan record",
      "type": "object",
      "properties": {
        "codeId": {
          "type": "string",
          "description": "Scanned code document ID"
        },
        "codeString": {
          "type": "string",
          "description": "Code string"
        },
        "companyId": {
          "type": "string",
          "description": "Company UID"
        },
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "scannedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Scan timestamp"
        }
      },
      "required": ["codeId", "codeString", "companyId", "productId"]
    },
    "Report": {
      "title": "Report",
      "description": "Consumer counterfeit or suspicious item report",
      "type": "object",
      "properties": {
        "codeId": {
          "type": "string",
          "description": "Code ID if matched"
        },
        "companyId": {
          "type": "string",
          "description": "Company UID if matched"
        },
        "codeString": {
          "type": "string",
          "description": "Reported code string"
        },
        "contact": {
          "type": "string",
          "description": "Optional consumer contact"
        },
        "message": {
          "type": "string",
          "description": "Report description"
        },
        "reviewed": {
          "type": "boolean",
          "description": "Whether admin has triaged this report"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp created"
        }
      },
      "required": ["codeString", "message"]
    }
  },
  "firestore": {
    "/roles/{uid}": {
      "schema": "Role",
      "description": "Access roles for administrators and special accounts"
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Brand manufacturer accounts"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Verified product catalogs"
    },
    "/batches/{batchId}": {
      "schema": "Batch",
      "description": "Production batches for serialization"
    },
    "/batchStatus/{batchId}": {
      "schema": "PublicBatchStatus",
      "description": "Publicly readable batch recall and expiry provenance"
    },
    "/productStatus/{productId}": {
      "schema": "PublicProductStatus",
      "description": "Publicly readable product recall and SKU provenance"
    },
    "/codes/{codeId}": {
      "schema": "Code",
      "description": "Individual serialized item tags"
    },
    "/codes/{codeId}/scans/{scanId}": {
      "schema": "Scan",
      "description": "Verification scan audit trail"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Consumer counterfeit reports"
    }
  }
}
